{
  "name": "jrf-farming",
  "version": "1.0.0",
  "description": "Ruby on Rails farming management application",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --outdir=app/assets/builds --public-path=assets",
    "build:css": "tailwindcss -i ./app/assets/stylesheets/application.tailwind.css -o ./app/assets/builds/tailwind.css --minify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nick198801/JRF_Farming.git"
  },
  "keywords": [
    "rails",
    "farming",
    "agriculture",
    "management"
  ],
  "author": "Nick198801",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Nick198801/JRF_Farming/issues"
  },
  "homepage": "https://github.com/Nick198801/JRF_Farming#readme",
  "devDependencies": {
    "esbuild": "^0.19.0",
    "tailwindcss": "^3.3.0"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.1",
    "@hotwired/turbo-rails": "^7.3.0"
  }
}
